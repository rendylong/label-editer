{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realibox.local/schemas/review-manifest-v1.schema.json",
  "title": "Label Production Review Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "createdAt", "input", "resolvedProject", "blueprint", "designReviewManifest", "model", "areaTargetsSha256", "areas", "artifacts"],
  "properties": {
    "version": { "const": 1 },
    "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
    "input": { "$ref": "#/$defs/input" },
    "resolvedProject": { "$ref": "#/$defs/resolvedProject" },
    "blueprint": { "$ref": "#/$defs/revisionBinding" },
    "designReviewManifest": { "$ref": "#/$defs/digestBinding" },
    "model": { "$ref": "#/$defs/model" },
    "areaTargetsSha256": { "$ref": "#/$defs/sha256" },
    "areas": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/area" } },
    "artifacts": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "#/$defs/artifact" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "opaqueId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "revision": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "carrier": { "enum": ["direct_surface_print", "applied_label", "clear_label", "in_mold", "foil_or_ink_only", "bare"] },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "revision", "sha256"],
      "properties": {
        "kind": { "enum": ["label-spec-v2", "label-project-v3"] },
        "revision": { "$ref": "#/$defs/revision" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "revisionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "sha256"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "resolvedProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision", "sha256", "areaTargetsSha256"],
      "properties": {
        "path": { "const": "resolved-project.lbl.json" },
        "revision": { "$ref": "#/$defs/revision" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "areaTargetsSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "digestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint"],
      "properties": { "fingerprint": { "$ref": "#/$defs/revision" } }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "side", "carrier"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" },
        "side": { "enum": ["front", "back", "left", "right", "wrap", "top", "bottom", "neck", "custom"] },
        "carrier": { "$ref": "#/$defs/carrier" }
      }
    },
    "vector3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "direction", "target", "up", "fov"],
      "properties": {
        "position": { "$ref": "#/$defs/vector3" },
        "direction": { "$ref": "#/$defs/vector3" },
        "target": { "$ref": "#/$defs/vector3" },
        "up": { "$ref": "#/$defs/vector3" },
        "fov": { "type": "number", "exclusiveMinimum": 0, "maximum": 180 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "mimeType", "width", "height", "viewKind"],
      "allOf": [{
        "if": {
          "properties": { "viewKind": { "enum": ["flat-artwork", "surface-face"] } },
          "required": ["viewKind"]
        },
        "then": {
          "required": ["areaId", "carrier"],
          "properties": { "areaId": true, "carrier": true }
        }
      }],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mimeType": { "const": "image/png" },
        "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "height": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "viewKind": { "enum": ["flat-artwork", "surface-face", "model-front", "model-back", "review-sheet"] },
        "camera": { "$ref": "#/$defs/camera" },
        "areaId": { "$ref": "#/$defs/opaqueId" },
        "carrier": { "$ref": "#/$defs/carrier" }
      }
    }
  }
}
