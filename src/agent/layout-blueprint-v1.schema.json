{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realibox.local/schemas/layout-blueprint-v1.schema.json",
  "title": "Label Layout Blueprint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "revision", "carrierDefaults", "assets", "areas"],
  "properties": {
    "version": { "const": 1 },
    "revision": { "$ref": "#/$defs/revision" },
    "carrierDefaults": { "$ref": "#/$defs/carrierDefaults" },
    "assets": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/asset" }
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/area" }
    }
  },
  "$defs": {
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "boundedString": { "type": "string", "maxLength": 4096 },
    "carrier": {
      "enum": ["direct_surface_print", "applied_label", "clear_label", "in_mold", "foil_or_ink_only", "bare"]
    },
    "carrierDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["carrier"],
      "properties": {
        "carrier": { "$ref": "#/$defs/carrier" },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/boundedString" }
        },
        "alternative": { "$ref": "#/$defs/carrier" },
        "tradeoff": { "$ref": "#/$defs/boundedString" },
        "assumptions": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/boundedString" }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "mimeType"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
        "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "height": { "type": "integer", "minimum": 1, "maximum": 32768 }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "normalizedBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process"],
      "properties": {
        "process": {
          "enum": ["screen_print", "pad_print", "digital_print", "offset_print", "white_underbase", "varnish", "hot_stamp_foil", "emboss", "deboss", "in_mold", "batch_code"]
        },
        "spotName": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "const": "white_underbase" } },
        "requiredMask": { "enum": ["color", "metalness", "roughness", "bump", "white_underbase"] }
      }
    },
    "flattenedFallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "nonEditableLayerIds", "nonEditableTextIds", "lostSeparations", "vectorAlternative"],
      "properties": {
        "accepted": { "type": "boolean" },
        "nonEditableLayerIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "nonEditableTextIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "lostSeparations": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "vectorAlternative": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "anchor", "rotation", "opacity", "visible", "zIndex", "processes"],
      "oneOf": [
        { "required": ["boundsMm"], "properties": { "boundsMm": true } },
        { "required": ["normalizedBounds"], "properties": { "normalizedBounds": true } }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["text", "image", "shape"] },
        "boundsMm": { "$ref": "#/$defs/bounds" },
        "normalizedBounds": { "$ref": "#/$defs/normalizedBounds" },
        "anchor": { "enum": ["top_left", "top_center", "center", "baseline_left", "baseline_center"] },
        "rotation": { "type": "number", "minimum": -360, "maximum": 360 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "visible": { "type": "boolean" },
        "zIndex": { "type": "integer", "minimum": -32768, "maximum": 32767 },
        "processes": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/process" } },
        "flattenedFallback": { "$ref": "#/$defs/flattenedFallback" },
        "text": { "type": "string", "maxLength": 32768 },
        "language": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[A-Za-z0-9-]+$" },
        "writingDirection": { "enum": ["auto", "ltr", "rtl"] },
        "fontAsset": { "$ref": "#/$defs/id" },
        "fontStack": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "fontSizeMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "fontWeight": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1000 }, { "enum": ["normal", "bold"] }] },
        "letterSpacingEm": { "type": "number", "minimum": -10, "maximum": 100 },
        "lineHeight": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "alignment": { "enum": ["left", "center", "right", "justify"] },
        "wrapPolicy": { "enum": ["none", "word", "character"] },
        "maxLines": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "color": { "type": "string", "maxLength": 64 },
        "assetId": { "$ref": "#/$defs/id" },
        "fit": { "enum": ["contain", "cover", "stretch"] },
        "shape": { "enum": ["rectangle", "rounded_rectangle", "ellipse", "line", "polygon", "path"] },
        "pathData": { "type": "string", "minLength": 1, "maxLength": 131072 },
        "pathViewBox": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "fillRule": { "enum": ["nonzero", "evenodd"] },
        "fill": { "type": "string", "maxLength": 64 },
        "stroke": { "type": "string", "maxLength": 64 },
        "strokeWidthMm": { "type": "number", "minimum": 0, "maximum": 1000 },
        "cornerRadiusMm": { "type": "number", "minimum": 0, "maximum": 1000 },
        "points": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "type": "number" }],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape"],
      "properties": {
        "shape": { "enum": ["rectangle", "rounded_rectangle", "ellipse", "custom"] },
        "radiusMm": { "type": "number", "minimum": 0, "maximum": 1000 },
        "pathData": { "type": "string", "minLength": 1, "maxLength": 131072 }
      }
    },
    "substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "opacity"],
      "properties": {
        "kind": { "enum": ["opaque", "transparent"] },
        "color": { "type": "string", "maxLength": 64 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "boundary": { "$ref": "#/$defs/boundary" },
        "material": { "type": "string", "maxLength": 256 },
        "adhesive": { "type": "string", "maxLength": 256 }
      }
    },
    "artboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthMm", "heightMm", "background"],
      "properties": {
        "widthMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
        "heightMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
        "background": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "side", "carrier", "artboard", "placementIntent", "layers"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "side": { "enum": ["front", "back", "left", "right", "wrap", "top", "bottom", "neck", "custom"] },
        "carrier": { "$ref": "#/$defs/carrier" },
        "artboard": { "$ref": "#/$defs/artboard" },
        "placementIntent": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "substrate": { "$ref": "#/$defs/substrate" },
        "placementPolicy": { "enum": ["fit", "crop-approved", "block"] },
        "layers": { "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/layer" } }
      }
    }
  }
}
