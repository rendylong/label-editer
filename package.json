{
  "name": "glb-label-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Codex and MCP plugin for inspecting, designing, previewing, and exporting cosmetic labels on GLB packaging",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "label-cli": "./scripts/label-cli.mjs"
  },
  "scripts": {
    "dev": "vite",
    "generate:label-validator": "node scripts/generate-label-validator.mjs",
    "prebuild": "pnpm generate:label-validator",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretest": "pnpm generate:label-validator",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:plugin-e2e": "vitest run tests/pluginE2E.test.ts --testTimeout=120000",
    "plugin:verify": "pnpm test && pnpm build && pnpm test:plugin-e2e"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "draco3dgltf": "1.5.7",
    "konva": "^10.3.1",
    "playwright": "1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.5",
    "three": "^0.185.1",
    "zod": "4.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
}
